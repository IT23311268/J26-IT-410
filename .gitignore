# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Data — never commit real papers, PDFs, or generated artifacts
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.pdf

# Node — the React client's dependencies.
#
# Its BUILD OUTPUT, api/static/app/, is deliberately NOT ignored. That
# is what lets the demo machine serve /app with neither Node nor a
# network: `cd web && npm run build` runs on a development machine and
# the result is committed. Ignoring it would mean every clone — and
# the laptop plugged into the projector — needs an npm install first.
web/node_modules/
npm-debug.log*

# Secrets / env
.env
*.key

# OS / editor
.DS_Store
.vscode/
.idea/
